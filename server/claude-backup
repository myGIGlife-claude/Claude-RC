#!/usr/bin/env bash
# claude-backup — one encrypted file with everything a cLaudeRC server user needs on a new server.
#
#   claude-backup export [--out FILE] [--slim] [--projects] [--docker] [--no-claude-login] [--pass-file F]
#   claude-backup plan [--json] [--slim] [--projects] [--docker] [--no-claude-login]
#   claude-backup receive
#   claude-backup import FILE [--pass-file F] [--dry-run] [--clone] [--with-authorized-keys] [--from USER@HOST] [--manifest-out OUT]
#   claude-backup list FILE [--pass-file F]
#
# Run `claude-backup --help` for the details. The archive is
# tar | gzip | gpg (AES256, symmetric): no big temp files, passphrase only via
# files or the terminal, never on a command line.

set -euo pipefail
umask 077

TMP="" PART="" PASSFILE="" GEN_PASS="" WPID="" READ_FD="" EXCL=() TAREX=() WITHAK=0

usage() {
  cat <<'EOF'
claude-backup — encrypted backup and restore of a cLaudeRC server user's setup.

  claude-backup export [--out FILE] [--slim] [--projects] [--docker] [--no-claude-login] [--pass-file F]
  claude-backup plan [--json] [--slim] [--projects] [--docker] [--no-claude-login]
  claude-backup receive
  claude-backup clone MANIFEST     clone the manifest's missing clean repos (needs GitHub access)
  claude-backup import FILE [--pass-file F] [--dry-run] [--clone] [--with-authorized-keys] [--from USER@HOST] [--manifest-out OUT]
  claude-backup list FILE [--pass-file F]
  claude-backup --help

export   Writes ONE encrypted file (default ~/backups/clauderc-backup-<host>-<time>.tar.gz.gpg,
         folder mode 700, file mode 600): Claude settings, logins, skills, memory and chat history,
         cLaudeRC config (keys, workers' logins, env), SSH/git/GitHub/AWS/... credentials, helper
         scripts, and a manifest.json (what was found on this server, no secret values).
         Work that exists only here is rescued: every git repo directly under the projects folder
         (PROJECTS_DIR in ~/.config/claude-launcher/config, default ~/projects; override with
         CLAUDE_BACKUP_PROJECTS=dir1:dir2) that has unpushed commits, uncommitted or untracked
         changes, no upstream branch or no remote is stored with its .git (files that .gitignore
         ignores are left out). A repo bigger than 500 MB (CLAUDE_BACKUP_RESCUE_MAX_MB) is skipped
         and reported. Clean, fully pushed repos are not stored: import --clone clones them again.
   --out FILE      where to write (an existing file is never overwritten)
   --slim          leave out plugin caches and marketplaces (Claude downloads them again)
   --projects      store ALL repos and non-git folders under the projects folder
                   (non-git folders without node_modules, build, .gradle, target, .cache, __pycache__)
   --docker        also store every named docker volume (needs docker access; stop databases first
                   for a consistent copy; needs temporary space in the output folder for the
                   compressed volumes)
   --no-claude-login  leave out every Claude credentials file (~/.claude/.credentials.json and the
                   workers' home/.credentials.json); the rest of those folders is stored. The manifest
                   records which logins existed (names only) and "claude_logins_included".
   --pass-file F   passphrase from file F (or env CLAUDE_BACKUP_PASS_FILE). Without one a
                   passphrase like K7QD-M2XW-... is generated and shown ONCE at the end:
                   write it down, it is not saved anywhere.
   With env CLAUDE_BACKUP_PROGRESS=1, "PROGRESS <phase> <percent>" lines go to stderr
   (collect, archive, done).

plan     What export would do, without writing an archive or asking for a passphrase: repos and their
         state, other project folders, docker volumes/containers, which Claude logins exist, the size
         (estimate_mb) and the facts of the manifest. Takes --slim, --projects, --docker and
         --no-claude-login like export, so the estimate matches. --json prints ONE JSON object.
         Never prints secret values.

receive  Reads ONE stream on stdin into ~/backups/incoming-<time>.gpg (folder 700, file 600) and
         prints the file name. Refuses (exit 1, nothing left behind) more than
         CLAUDE_BACKUP_RECEIVE_MAX_MB (default 20480) or when the free disk space is smaller than
         the stream so far plus 1 GB. Meant as an SSH forced command: ignores $SSH_ORIGINAL_COMMAND,
         takes no arguments, needs no passphrase.

import  Restores into $HOME on the new server. The passphrase comes from --pass-file, env
         CLAUDE_BACKUP_PASS_FILE or a prompt (no echo). The file is fully read once before
         anything is written, so a wrong passphrase or a damaged file changes nothing.
         Existing files are overwritten, but every path about to be overwritten is first copied
         to ~/backups/pre-restore-<time>/. Never uses sudo, never touches systemd, never starts
         anything; prints what is still to do.
         NOT restored: ~/.ssh/authorized_keys (it would replace this server's phone key line and let the
         old server's keys in; see --with-authorized-keys) and ~/.config/claude-launcher/config (this
         server's own file stays; only PROJECTS_DIR is taken from the backup when this one sets none, so
         re-check ALLOW_RUN/PROJECTS_DIR there). The migrate transfer key is never stored in a backup.
   FILE            local path (with --from: path on the old server)
   --from U@H      first fetch FILE from U@H with scp (key login, no password prompt) into ~/backups.
                   U@H:PATH also works instead of FILE.
   --dry-run       list what would be restored and show the manifest summary; writes nothing
   --clone         git clone every clean, fully pushed repo of the manifest that does not exist yet
   --with-authorized-keys  also restore ~/.ssh/authorized_keys from the backup (replaces the file): only
                   for moving the SAME user to a new machine by hand. Afterwards the phone works if its
                   key was in the old file; otherwise re-run the installer with the phone key.
   --manifest-out OUT  after a successful restore, write the manifest that was restored to OUT (mode 600)
   With env CLAUDE_BACKUP_PROGRESS=1, "PROGRESS <phase> <percent>" lines go to stderr (verify,
   extract, clone).
   (docker volumes in the archive are restored into new volumes; an existing non-empty volume is
   never overwritten)

list     Prints the manifest of FILE (the first member; no full read).

The file contains every secret of this server (encrypted). Delete it after the move.
EOF
}

die() { echo "claude-backup: $*" >&2; exit 1; }
warn() { echo "claude-backup: warning: $*" >&2; }
bad_usage() { echo "claude-backup: $*" >&2; usage >&2; exit 2; }

cleanup() {
  local rc=$?
  [[ -z "$WPID" ]] || kill "$WPID" 2>/dev/null || true
  [[ -z "$PART" ]] || rm -f -- "$PART"
  [[ -z "$TMP" ]] || rm -rf -- "$TMP"
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

need() { local t; for t in "$@"; do command -v "$t" >/dev/null || die "$t is required (e.g. sudo apt install $t)"; done; }

abs() { case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s\n' "$PWD/$1" ;; esac; }

# Relative path inside $HOME, no ".." parts: used for every path read from an archive.
safe_rel() {
  case "$1" in
    "" | /* | .. | ../* | */.. | */../*) return 1 ;;
  esac
}

gz() { if command -v pigz >/dev/null; then pigz -c; else gzip -c; fi; }
gunz() { if command -v pigz >/dev/null; then pigz -dc; else gzip -dc; fi; }

# JSON array of the non-empty lines of a file.
lines_json() { jq -Rn '[inputs | select(length > 0)]' <"$1"; }

# ---------------------------------------------------------------- progress
# With CLAUDE_BACKUP_PROGRESS=1: "PROGRESS <phase> <percent>" lines on stderr (for the app).
progress_on() { [[ "${CLAUDE_BACKUP_PROGRESS:-}" == 1 ]]; }
progress() { if progress_on; then echo "PROGRESS $1 $2" >&2; fi; return 0; }

# watch_size <phase> <file> <total bytes>: background job, reports the size of a growing file.
watch_size() {
  local pct last=0 sz
  while :; do
    sleep 1
    sz="$(stat -c %s -- "$2" 2>/dev/null || echo 0)"
    pct=$((${3:-0} > 0 ? sz * 100 / $3 : 0))
    ((pct <= 99)) || pct=99
    if ((pct != last)); then progress "$1" "$pct"; last=$pct; fi
  done
}

# start_read <phase> <file>: with progress on, opens fd 9 on <file> (decrypt then reads from it) and
# reports its read offset in the background. stop_read ends it.
start_read() {
  READ_FD=""
  progress_on || return 0
  exec 9<"$2"
  READ_FD=9
  progress "$1" 0
  (
    total="$(stat -c %s -- "$2" 2>/dev/null || echo 0)" last=0
    while :; do
      sleep 1
      pos="$(awk '/^pos:/ { print $2 }' "/proc/$$/fdinfo/9" 2>/dev/null || true)"
      pct=$((total > 0 ? ${pos:-0} * 100 / total : 0))
      ((pct <= 99)) || pct=99
      if ((pct != last)); then progress "$1" "$pct"; last=$pct; fi
    done
  ) &
  WPID=$!
}
stop_read() {
  if [[ -n "$WPID" ]]; then
    kill "$WPID" 2>/dev/null || true
    wait "$WPID" 2>/dev/null || true
    WPID=""
  fi
  if [[ -n "$READ_FD" ]]; then exec 9<&-; READ_FD=""; fi
  return 0
}

# ---------------------------------------------------------------- passphrase
# Sets PASSFILE (a file holding the passphrase) for import/list.
resolve_pass() {
  local pf="${PASS_FILE:-${CLAUDE_BACKUP_PASS_FILE:-}}" p=""
  if [[ -n "$pf" ]]; then
    pf="$(abs "$pf")"
    [[ -f "$pf" && -r "$pf" && -s "$pf" ]] || die "passphrase file $pf is missing, empty or unreadable"
    PASSFILE="$pf"
    return 0
  fi
  { : </dev/tty; } 2>/dev/null || die "no passphrase: use --pass-file FILE (or env CLAUDE_BACKUP_PASS_FILE); there is no terminal to ask on"
  printf 'Backup passphrase: ' >/dev/tty
  IFS= read -rs p </dev/tty || { echo >/dev/tty; die "no passphrase entered"; }
  echo >/dev/tty
  [[ -n "$p" ]] || die "empty passphrase"
  printf '%s\n' "$p" >"$TMP/pass"
  PASSFILE="$TMP/pass"
}

# ---------------------------------------------------------------- reading an archive
# decrypt <file>: plain tar.gz on stdout, gpg's complaints in $TMP/gpg.err.
decrypt() {
  if [[ "$READ_FD" == 9 ]]; then # start_read keeps the file open on fd 9 so its offset can be reported
    gpg --batch --quiet --no-tty --pinentry-mode loopback --passphrase-file "$PASSFILE" --decrypt <&9 2>>"$TMP/gpg.err"
  else
    gpg --batch --quiet --no-tty --pinentry-mode loopback --passphrase-file "$PASSFILE" --decrypt <"$1" 2>>"$TMP/gpg.err"
  fi
}

gpg_reason() {
  local line
  line="$(grep -m1 -i 'gpg:' "$TMP/gpg.err" 2>/dev/null || true)"
  [[ -z "$line" ]] || printf ' (%s)' "$line"
}

# Whole-archive read: listing into $TMP/list.txt. Fails cleanly on a wrong passphrase or damage.
check_archive() {
  : >"$TMP/gpg.err"
  if ! decrypt "$1" | gunz | tar -tf - >"$TMP/list.txt" 2>"$TMP/tar.err"; then
    die "cannot read $1: wrong passphrase or damaged file$(gpg_reason). Nothing was written."
  fi
}

# First member only (manifest.json) into $1, from archive $2.
read_manifest() {
  : >"$TMP/gpg.err"
  { decrypt "$2" | gunz | tar -xOf - --occurrence=1 manifest.json >"$1"; } 2>/dev/null || true
  jq -e '.version == 1' "$1" >/dev/null 2>&1 ||
    die "cannot read the manifest of $2: wrong passphrase, damaged file or not a claude-backup file$(gpg_reason)"
}

# ---------------------------------------------------------------- export
# Everything below runs with the current directory = $HOME.

add_path() { # add_path <path relative to $HOME>: only when it exists
  if [[ -e "$1" || -L "$1" ]]; then
    printf '%s\0' "$1" >>"$TMP/list"
    printf '%s\n' "$1" >>"$TMP/backed_up"
  fi
}

# Total bytes of the NUL-separated file list $1 (files only; missing ones count 0).
list_bytes() {
  xargs -0 -r stat -c %s -- <"$1" 2>/dev/null | awk '{ s += $1 } END { printf "%.0f\n", s + 0 }' || true
}

# git state of repo $1: no-remote | no-upstream | dirty | unpushed | clean.
# Anything git cannot answer counts as "not clean" so work is never skipped by mistake.
repo_state() {
  local d="$1" st ahead
  if [[ -z "$(git -C "$d" remote 2>/dev/null || true)" ]]; then echo no-remote; return; fi
  if ! git -C "$d" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then echo no-upstream; return; fi
  st="$(git -C "$d" status --porcelain 2>/dev/null)" || st="?"
  if [[ -n "$st" ]]; then echo dirty; return; fi
  st="$(git -C "$d" stash list 2>/dev/null)" || st="?"
  if [[ -n "$st" ]]; then echo dirty; return; fi
  ahead="$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null)" || ahead=1
  if [[ "$ahead" != 0 ]]; then echo unpushed; return; fi
  # Commits on other local branches that no remote has.
  st="$(git -C "$d" log --branches --not --remotes -n 1 --format=%H 2>/dev/null)" || st="?"
  [[ -z "$st" ]] || { echo unpushed; return; }
  echo clean
}

# Files of repo $1 (relative to $HOME) that belong in a rescue copy, plus its .git, into $2.
repo_list() {
  {
    printf '%s\0' "$1/.git"
    git -C "$1" ls-files -z --cached --others --exclude-standard | while IFS= read -r -d '' f; do
      if [[ -e "$1/$f" || -L "$1/$f" ]]; then printf '%s\0' "$1/$f"; fi
    done
  } >"$2"
}

dir_list() { # all files of non-git folder $1 into $2, minus rebuildable junk
  find "$1" \( -name node_modules -o -name build -o -name .gradle -o -name target -o -name .cache -o -name __pycache__ \) -prune -o ! -type d -print0 >"$2"
}

# Where the projects live: env, else PROJECTS_DIR of the cLaudeRC config, else ~/projects.
project_dirs() {
  local v cfg="$HOME/.config/claude-launcher/config"
  if [[ -n "${CLAUDE_BACKUP_PROJECTS:-}" ]]; then
    tr ':' '\n' <<<"$CLAUDE_BACKUP_PROJECTS"
    return 0
  fi
  v="$(grep -m1 '^PROJECTS_DIR=' "$cfg" 2>/dev/null | cut -d= -f2- | tr -d "\"'" || true)"
  v="${v//\$\{HOME\}/$HOME}"
  v="${v//\$HOME/$HOME}"
  [[ "$v" == /?* ]] || v="$HOME/projects"
  printf '%s\n' "${v%/}"
}

scan_projects() { # scan_projects <all 0|1> <max bytes>
  local all="$1" max="$2" pd d name rel state branch rescued reason size gitk url r
  while IFS= read -r pd; do
    [[ -n "$pd" && -d "$pd" ]] || continue
    pd="${pd%/}"
    if [[ "$pd" != "$HOME"/* ]]; then warn "projects folder $pd is not inside $HOME: skipped"; continue; fi
    for d in "$pd"/*/; do
      d="${d%/}"
      [[ -d "$d" && ! -L "$d" ]] || continue
      name="$(basename -- "$d")"
      rel="${d#"$HOME"/}"
      if [[ -e "$d/.git" ]]; then
        if ! command -v git >/dev/null; then warn "git is missing: $rel not scanned"; continue; fi
        state="$(repo_state "$d")"
        r="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
        if [[ -z "$r" ]]; then
          r="$(git -C "$d" remote 2>/dev/null | head -n 1 || true)"
          [[ -z "$r" ]] || r="$(git -C "$d" remote get-url "$r" 2>/dev/null || true)"
        fi
        # Never let a token in a remote URL reach the manifest.
        url="$(sed -E 's#^([A-Za-z][A-Za-z0-9+.-]*://)[^/@]*@#\1#' <<<"$r")"
        branch="$(git -C "$d" symbolic-ref --short -q HEAD 2>/dev/null || true)"
        rescued=false reason=""
        if [[ "$state" != clean || "$all" == 1 ]]; then
          if repo_list "$rel" "$TMP/repo.list"; then
            gitk="$(du -sk "$d/.git" 2>/dev/null | cut -f1 || true)"
            size=$(($(list_bytes "$TMP/repo.list") + ${gitk:-0} * 1024))
            if ((size > max)); then
              reason="larger than $((max / 1048576)) MB ($((size / 1048576)) MB), not stored"
              printf '  %s (%s): %s\n' "$rel" "$state" "$reason" >>"$TMP/skipped"
            else
              cat "$TMP/repo.list" >>"$TMP/list"
              printf '%s\n' "$rel" >>"$TMP/backed_up"
              rescued=true
            fi
          else
            reason="could not list the files (git failed), not stored"
            printf '  %s (%s): %s\n' "$rel" "$state" "$reason" >>"$TMP/skipped"
          fi
        fi
        jq -nc --arg dir "$name" --arg path "$rel" --arg remote "$url" --arg branch "$branch" --arg state "$state" \
          --argjson rescued "$rescued" --arg reason "$reason" \
          '{dir:$dir, path:$path, remote:$remote, branch:$branch, state:$state, rescued:$rescued} + (if $reason != "" then {skipped_reason:$reason} else {} end)' \
          >>"$TMP/repos.jsonl"
      else
        printf '%s\n' "$name" >>"$TMP/other_dirs"
        if [[ "$all" == 1 ]]; then
          dir_list "$rel" "$TMP/repo.list"
          size="$(list_bytes "$TMP/repo.list")"
          if ((size > max)); then
            printf '  %s (not a git folder): larger than %d MB (%d MB), not stored\n' "$rel" $((max / 1048576)) $((size / 1048576)) >>"$TMP/skipped"
          else
            cat "$TMP/repo.list" >>"$TMP/list"
            printf '%s\n' "$rel" >>"$TMP/backed_up"
            printf '%s\n' "$name" >>"$TMP/other_saved"
          fi
        fi
      fi
    done
  done < <(project_dirs)
  return 0
}

docker_ok() { command -v docker >/dev/null && timeout 20 docker volume ls -q >/dev/null 2>&1; }

docker_vols() { # named docker volumes that export --docker copies
  local v
  while IFS= read -r v; do
    if [[ "$v" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && ! "$v" =~ ^[0-9a-f]{64}$ ]]; then printf '%s\n' "$v"; fi
  done < <(docker volume ls -q 2>/dev/null || true)
}

# build_excl <slim> <no claude login>: sets EXCL, the tar exclude patterns (relative to $HOME).
build_excl() {
  EXCL=(.claude/shell-snapshots .claude/session-env .claude/cache .claude/file-history
    .config/claude-launcher/usage-cache .config/claude-launcher/plugin-updates.json
    .config/claude-launcher/migrate
    '.config/claude-launcher/workers/*/trees'
    '.config/claude-launcher/workers/*/tasks/*.in' '.config/claude-launcher/workers/*/tasks/*.out'
    '.config/claude-launcher/workers/*/tasks/*.err' '.config/claude-launcher/workers/*/tasks/*.started'
    '.config/claude-launcher/workers/*/run.lock*')
  if (($1)); then
    EXCL+=(.claude/plugins/cache .claude/plugins/marketplaces
      '.config/claude-launcher/workers/*/home/plugins/cache' '.config/claude-launcher/workers/*/home/plugins/marketplaces'
      '.config/claude-launcher/workers/*/home/.claude/plugins/cache' '.config/claude-launcher/workers/*/home/.claude/plugins/marketplaces')
  fi
  if (($2)); then
    EXCL+=(.claude/.credentials.json '.config/claude-launcher/workers/*/home/.credentials.json')
  fi
}

# tar_excl_args: TAREX = the tar options that select what goes into the archive.
tar_excl_args() {
  local rel
  TAREX=(--null --anchored --no-wildcards-match-slash --ignore-failed-read)
  for rel in "${EXCL[@]}"; do TAREX+=("--exclude=$rel"); done
}

# Bytes of the files export would archive (from $TMP/list and EXCL; dry run of tar, nothing is read).
est_bytes() {
  tar_excl_args
  { tar --create --file=/dev/null -vv "${TAREX[@]}" -C "$HOME" -T "$TMP/list" 2>/dev/null || true; } |
    awk '{ s += $3 } END { printf "%.0f\n", s + 0 }'
}

files_bytes() { # total bytes of the files under folder $1
  find "$1" -type f -printf '%s\n' 2>/dev/null | awk '{ s += $1 } END { printf "%.0f\n", s + 0 }' || true
}

# Facts that plan prints and export puts in the manifest (names and numbers only, never values).
# Needs the current directory = $HOME and $TMP.
collect() { # collect <all 0|1> <max bytes>
  local include=(.claude .claude.json .config/claude-launcher .config/claude-setup .agents
    .config/gh .config/glab-cli .config/stripe .config/b2 .config/git .aws .ssh .gitconfig .git-credentials
    .docker/config.json .npmrc claude-setup.sh bin
    .local/bin/claude-autostart .local/bin/clauderc-team .local/bin/claude-push
    .local/bin/claude-plugin-updates .local/bin/youtube-upload) rel f w
  touch "$TMP/list" "$TMP/backed_up" "$TMP/repos.jsonl" "$TMP/other_dirs" "$TMP/other_saved" "$TMP/skipped"
  for rel in "${include[@]}"; do add_path "$rel"; done

  scan_projects "$1" "$2"

  # Docker facts (named volumes and containers, also without --docker).
  : >"$TMP/docker_volumes"; : >"$TMP/docker_containers"
  if docker_ok; then
    { docker volume ls -q 2>/dev/null || true; } | grep -vE '^[0-9a-f]{64}$' >"$TMP/docker_volumes" || true
    docker ps -a --format '{{.Names}}:{{.Image}}' >"$TMP/docker_containers" 2>/dev/null || true
  fi

  { systemctl list-unit-files --state=enabled --no-legend 2>/dev/null | awk '{print $1}' | grep -i claude || true
    systemctl --user list-unit-files --state=enabled --no-legend 2>/dev/null | awk '{print $1}' | grep -i claude || true
  } | sort -u >"$TMP/units" || true
  { ss -H -ltn 2>/dev/null | awk '{ n = split($4, a, ":"); print a[n] }' | sort -un || true; } >"$TMP/ports"
  { grep -hoE '^(export +)?[A-Za-z_][A-Za-z0-9_]*=' "$HOME/.config/claude-launcher/env" 2>/dev/null |
    sed -E 's/^export +//; s/=$//' || true; } >"$TMP/envnames"

  # Which Claude logins exist here (names only), whether or not they are stored.
  if [[ -f .claude/.credentials.json ]]; then echo true >"$TMP/login_main"; else echo false >"$TMP/login_main"; fi
  : >"$TMP/login_workers"
  for f in .config/claude-launcher/workers/*/home/.credentials.json; do
    [[ -f "$f" ]] || continue
    w="${f#.config/claude-launcher/workers/}"
    printf '%s\n' "${w%%/*}" >>"$TMP/login_workers"
  done
}

facts_json() {
  jq -n --slurpfile repos "$TMP/repos.jsonl" \
    --argjson other_dirs "$(lines_json "$TMP/other_dirs")" --argjson other_saved "$(lines_json "$TMP/other_saved")" \
    --argjson vols "$(lines_json "$TMP/docker_volumes")" --argjson cont "$(lines_json "$TMP/docker_containers")" \
    --argjson units "$(lines_json "$TMP/units")" --argjson envnames "$(lines_json "$TMP/envnames")" \
    --argjson backed "$(lines_json "$TMP/backed_up")" \
    --argjson ports "$(jq -Rn '[inputs | tonumber?]' <"$TMP/ports")" \
    --argjson main "$(cat "$TMP/login_main")" --argjson workers "$(lines_json "$TMP/login_workers")" \
    '{repos: $repos, other_dirs: $other_dirs, other_dirs_saved: $other_saved, docker_volumes: $vols,
      docker_containers: $cont, systemd_units: $units, listening: $ports, env_var_names: $envnames, backed_up: $backed,
      claude_logins: {main: $main, workers: $workers}}'
}

cmd_export() {
  local out="" slim=0 all=0 docker=0 noclaude=0 host ts outdir max_mb gen="" vols=() v rel tarrc=0 est=0
  while (($#)); do
    case "$1" in
      --out) (($# >= 2)) || bad_usage "--out needs a file"; out="$2"; shift 2 ;;
      --slim) slim=1; shift ;;
      --projects) all=1; shift ;;
      --docker) docker=1; shift ;;
      --no-claude-login) noclaude=1; shift ;;
      --pass-file) (($# >= 2)) || bad_usage "--pass-file needs a file"; PASS_FILE="$2"; shift 2 ;;
      *) bad_usage "unknown option for export: $1" ;;
    esac
  done
  need tar gpg jq gzip
  host="$(hostname 2>/dev/null | tr -cd 'A-Za-z0-9._-' || true)"
  host="${host:-server}"
  ts="$(date +%Y%m%d-%H%M%S)"
  [[ -n "$out" ]] || out="$HOME/backups/clauderc-backup-$host-$ts.tar.gz.gpg"
  out="$(abs "$out")"
  outdir="$(dirname -- "$out")"
  if [[ ! -d "$outdir" ]]; then mkdir -p "$outdir"; chmod 700 "$outdir"; fi
  [[ "$outdir" != "$HOME/backups" ]] || chmod 700 "$outdir"
  [[ ! -e "$out" ]] || die "$out already exists: pick another --out"
  [[ -z "${PASS_FILE:-}" ]] || PASS_FILE="$(abs "$PASS_FILE")"
  max_mb="${CLAUDE_BACKUP_RESCUE_MAX_MB:-500}"
  [[ "$max_mb" =~ ^[0-9]+$ ]] || die "CLAUDE_BACKUP_RESCUE_MAX_MB must be a number"

  # Temp files (the passphrase, lists, docker volumes) live next to the output, never in /tmp.
  TMP="$(mktemp -d "$outdir/.claude-backup.XXXXXX")"
  PART="$out.part"
  : >"$TMP/gpg.err"
  touch "$TMP/list" "$TMP/backed_up" "$TMP/repos.jsonl" "$TMP/other_dirs" "$TMP/other_saved" "$TMP/skipped"

  local pf="${PASS_FILE:-${CLAUDE_BACKUP_PASS_FILE:-}}"
  if [[ -n "$pf" ]]; then
    pf="$(abs "$pf")"
    [[ -f "$pf" && -r "$pf" && -s "$pf" ]] || die "passphrase file $pf is missing, empty or unreadable"
    PASSFILE="$pf"
  else
    gen="$(LC_ALL=C tr -dc 'A-HJ-NP-Z2-9' </dev/urandom | head -c 20 || true)"
    [[ "${#gen}" -eq 20 ]] || die "could not generate a passphrase"
    GEN_PASS="${gen:0:4}-${gen:4:4}-${gen:8:4}-${gen:12:4}-${gen:16:4}"
    printf '%s\n' "$GEN_PASS" >"$TMP/pass"
    PASSFILE="$TMP/pass"
  fi

  cd "$HOME"
  echo "Collecting files from $HOME ..."
  progress collect 0

  build_excl "$slim" "$noclaude"
  # The output and temp files may live inside $HOME: never put them in themselves.
  if [[ "$outdir" == "$HOME"/* ]]; then
    rel="${outdir#"$HOME"/}"
    EXCL+=("$rel/.claude-backup.*" "$rel/$(basename -- "$out").part")
  fi

  collect "$all" $((max_mb * 1048576))

  if ((docker)); then
    if docker_ok; then
      while IFS= read -r v; do vols+=("$v"); done < <(docker_vols)
    else
      warn "docker is not available or not accessible: --docker skipped"
      docker=0
    fi
  fi
  if ((docker && ${#vols[@]} > 0)); then
    echo "Docker volumes: copying ${#vols[@]} (stop databases first for a consistent copy) ..."
    mkdir -p "$TMP/docker"
    for v in "${vols[@]}"; do
      docker run --rm -v "$v:/v:ro" busybox tar -C /v -czf - . >"$TMP/docker/$v.tar.gz" 2>"$TMP/docker.err" ||
        die "docker volume $v could not be copied: $(tail -n 1 "$TMP/docker.err")"
    done
  fi

  local cv=""
  if command -v claude >/dev/null; then cv="$(timeout 15 claude --version 2>/dev/null | head -n 1 || true)"; fi

  facts_json | jq --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg host "$(hostname 2>/dev/null || echo unknown)" \
    --arg user "$(id -un)" --arg home "$HOME" --arg cv "$cv" --argjson included "$((1 - noclaude))" \
    '{version: 1, created: $created, host: $host, user: $user, home: $home}
     + (if $cv != "" then {claude_version: $cv} else {} end)
     + {claude_logins_included: ($included == 1)} + .' \
    >"$TMP/manifest.json"

  tar_excl_args
  local targs=(--create --file=- "${TAREX[@]}")
  # The manifest goes first so `list` only has to read the start of the archive.
  targs+=(-C "$TMP" manifest.json -C "$HOME" -T "$TMP/list")
  [[ ! -d "$TMP/docker" ]] || targs+=(-C "$TMP" docker)

  echo "Writing the encrypted archive ..."
  if progress_on; then
    est="$(est_bytes)"
    if [[ -d "$TMP/docker" ]]; then est=$((est + $(files_bytes "$TMP/docker"))); fi
    progress archive 0
    watch_size archive "$PART" "$est" &
    WPID=$!
  fi
  # tar exits 1 when a file changed while it was read (live sessions write): fine.
  if ! { { tarrc=0; tar "${targs[@]}" 2>"$TMP/tar.err" || tarrc=$?; [[ "$tarrc" -le 1 ]] || exit "$tarrc"; } |
    gz |
    gpg --batch --quiet --no-tty --symmetric --cipher-algo AES256 --s2k-mode 3 --s2k-digest-algo SHA512 \
      --s2k-count 65011712 --compress-algo none --pinentry-mode loopback --passphrase-file "$PASSFILE" >"$PART" 2>>"$TMP/gpg.err"; }; then
    die "writing the archive failed: $(tail -n 3 "$TMP/tar.err" "$TMP/gpg.err" 2>/dev/null | tr '\n' ' ')"
  fi
  stop_read
  [[ -s "$PART" ]] || die "the archive is empty"
  chmod 600 "$PART"
  mv -f -- "$PART" "$out"
  PART=""
  # The passphrase must open what was just written.
  read_manifest "$TMP/check.json" "$out"
  progress "done" 100

  summary "$out" "$all" "$docker" "$slim"
}

summary() { # summary <out> <all> <docker> <slim>
  local out="$1" all="$2" docker="$3" size n
  size="$(du -h -- "$out" | awk '{print $1}')"
  echo
  echo "Backup written: $out ($size, mode 600)"
  echo
  n="$(jq -r '[.repos[] | select(.rescued)] | length' "$TMP/manifest.json")"
  echo "Git repos found: $(jq '.repos | length' "$TMP/manifest.json"), stored in the archive: $n"
  jq -r '.repos[] | "  " + (if .rescued then "STORED   " else "not stored" end) + " " + .path + "  [" + .state + "]"' "$TMP/manifest.json"
  if [[ -s "$TMP/skipped" ]]; then
    echo
    echo "!!! NOT STORED, TOO BIG (copy these yourself or push them) !!!"
    cat "$TMP/skipped"
  fi
  if [[ -s "$TMP/tar.err" ]]; then
    echo
    echo "tar warnings (first 10 of $(wc -l <"$TMP/tar.err")):"
    head -n 10 "$TMP/tar.err" | sed 's/^/  /'
  fi
  echo
  echo "NOT covered:"
  if ((docker)); then
    echo "  - docker volumes were copied, but containers/images are not: recreate them (compose files live in your projects)"
  else
    echo "  - docker data (volumes: $(jq -r '.docker_volumes | join(", ")' "$TMP/manifest.json" | sed 's/^$/none/')); use --docker"
  fi
  echo "  - services such as tailscale, bitcoind, databases, anything under systemd or listening on a port (see: claude-backup list)"
  if ((all)); then
    echo "  - non-git folders that were too big (listed above)"
  else
    echo "  - non-git folders under the projects folder: $(jq -r '.other_dirs | join(", ")' "$TMP/manifest.json" | sed 's/^$/none/') (use --projects)"
  fi
  echo "  - clean, pushed repos are not stored: they are cloned again by import --clone"
  echo
  echo "Restore on the new server (after installing cLaudeRC there):"
  printf "  claude-backup import %q --from %s@<this-server-address> --clone\n" "$out" "$(id -un)"
  echo "The file holds every secret of this server (encrypted): delete it after the move."
  if [[ -n "$GEN_PASS" ]]; then
    echo
    echo "================================================================"
    echo "  PASSPHRASE (write this down, it is not saved anywhere):"
    echo
    echo "      $GEN_PASS"
    echo "================================================================"
  fi
}

# ---------------------------------------------------------------- plan
cmd_plan() {
  local json=0 slim=0 all=0 docker=0 noclaude=0 max_mb bytes v kb
  while (($#)); do
    case "$1" in
      --json) json=1; shift ;;
      --slim) slim=1; shift ;;
      --projects) all=1; shift ;;
      --docker) docker=1; shift ;;
      --no-claude-login) noclaude=1; shift ;;
      *) bad_usage "unknown option for plan: $1" ;;
    esac
  done
  need tar jq
  max_mb="${CLAUDE_BACKUP_RESCUE_MAX_MB:-500}"
  [[ "$max_mb" =~ ^[0-9]+$ ]] || die "CLAUDE_BACKUP_RESCUE_MAX_MB must be a number"
  TMP="$(mktemp -d)"
  cd "$HOME"
  build_excl "$slim" "$noclaude"
  collect "$all" $((max_mb * 1048576))

  bytes="$(est_bytes)"
  if ((docker)); then
    if docker_ok; then
      while IFS= read -r v; do
        kb="$(docker run --rm -v "$v:/v:ro" busybox du -sk /v 2>/dev/null | awk '{ print $1; exit }' || true)"
        [[ "$kb" =~ ^[0-9]+$ ]] || kb=0
        bytes=$((bytes + kb * 1024))
      done < <(docker_vols)
    else
      warn "docker is not available or not accessible: --docker skipped"
    fi
  fi

  facts_json | jq --argjson est "$(((bytes + 1048575) / 1048576))" \
    '{repos: (.repos | map({dir, path, state, rescued, skipped_reason: (.skipped_reason // "")})),
      other_dirs, docker_volumes, docker_containers,
      logins: {claude: .claude_logins.main, workers: .claude_logins.workers},
      estimate_mb: $est, systemd_units, listening, env_var_names}' >"$TMP/plan.json"
  if ((json)); then
    jq -c . "$TMP/plan.json"
    return 0
  fi
  jq -r '"Plan (what export would do). Estimated size: about " + (.estimate_mb | tostring) + " MB before compression",
    "",
    "Git repos: " + (.repos | length | tostring),
    (.repos[] | "  " + (if .rescued then "STORED   " else "not stored" end) + " " + .path + "  [" + .state + "]"
      + (if .skipped_reason != "" then "  (" + .skipped_reason + ")" else "" end)),
    "Other project folders: " + (.other_dirs | join(", ") | if . == "" then "none" else . end),
    "Docker volumes: " + (.docker_volumes | join(", ") | if . == "" then "none" else . end),
    "Docker containers: " + (.docker_containers | join(", ") | if . == "" then "none" else . end),
    "Claude logins: main " + (if .logins.claude then "yes" else "no" end) + ", workers: "
      + (.logins.workers | join(", ") | if . == "" then "none" else . end),
    "Enabled services: " + (.systemd_units | join(", ") | if . == "" then "none" else . end),
    "Listening ports: " + (.listening | map(tostring) | join(", ") | if . == "" then "none" else . end),
    "Variable names in the cLaudeRC env file: " + (.env_var_names | join(", ") | if . == "" then "none" else . end)' "$TMP/plan.json"
}

# ---------------------------------------------------------------- receive
# One stream on stdin into ~/backups/incoming-<time>.gpg. Runs as an SSH forced command: never reads
# anything from the client but the stream itself.
cmd_receive() {
  local dir="$HOME/backups" max_mb="${CLAUDE_BACKUP_RECEIVE_MAX_MB:-20480}" base name n=0 size=0 prev avail chunk=16
  unset SSH_ORIGINAL_COMMAND
  (($# == 0)) || bad_usage "receive takes no arguments"
  [[ "$max_mb" =~ ^[0-9]+$ ]] || die "CLAUDE_BACKUP_RECEIVE_MAX_MB must be a number"
  mkdir -p "$dir"
  chmod 700 "$dir"
  base="incoming-$(date +%Y%m%d-%H%M%S)"
  name="$base.gpg"
  while [[ -e "$dir/$name" || -e "$dir/$name.part" ]]; do n=$((n + 1)); name="$base-$n.gpg"; done
  PART="$dir/$name.part"
  : >"$PART"
  while :; do
    avail="$(df -Pk -- "$dir" 2>/dev/null | awk 'NR == 2 { printf "%.0f\n", $4 * 1024 }' || true)"
    [[ "$avail" =~ ^[0-9]+$ ]] || avail=0
    ((avail >= size + 1073741824)) || die "not enough free disk space for the stream ($((avail / 1048576)) MB free, $((size / 1048576)) MB received so far, 1024 MB reserve): refused"
    prev=$size
    dd bs=1M count=$chunk iflag=fullblock status=none >>"$PART" || die "reading the stream failed"
    size="$(stat -c %s -- "$PART")"
    ((size <= max_mb * 1048576)) || die "more than $max_mb MB received (CLAUDE_BACKUP_RECEIVE_MAX_MB): refused"
    ((size - prev >= chunk * 1048576)) || break
  done
  ((size > 0)) || die "nothing received"
  chmod 600 "$PART"
  mv -- "$PART" "$dir/$name"
  PART=""
  printf '%s\n' "$name"
}

# ---------------------------------------------------------------- list
cmd_list() {
  local file=""
  while (($#)); do
    case "$1" in
      --pass-file) (($# >= 2)) || bad_usage "--pass-file needs a file"; PASS_FILE="$2"; shift 2 ;;
      -*) bad_usage "unknown option for list: $1" ;;
      *) [[ -z "$file" ]] || bad_usage "list takes one file"; file="$1"; shift ;;
    esac
  done
  [[ -n "$file" ]] || bad_usage "list needs a FILE"
  file="$(abs "$file")"
  [[ -f "$file" ]] || die "$file not found"
  need gpg tar jq gzip
  TMP="$(mktemp -d)"
  resolve_pass
  read_manifest "$TMP/manifest.json" "$file"
  jq . "$TMP/manifest.json"
}

# ---------------------------------------------------------------- import
fetch_from() { # fetch_from <user@host> <remote path>: sets FILE
  local dest
  need scp
  mkdir -p "$HOME/backups"
  chmod 700 "$HOME/backups"
  dest="$HOME/backups/$(basename -- "$2")"
  echo "Fetching $2 from $1 ..."
  scp -p -o BatchMode=yes -- "$1:$2" "$dest" || die "scp from $1 failed (is this server's key authorized there?)"
  chmod 600 "$dest"
  FILE="$dest"
}

restore_docker() { # restore_docker: volumes found in $TMP/list.txt
  local vol list=() nonempty
  while IFS= read -r vol; do
    vol="${vol#docker/}"
    vol="${vol%.tar.gz}"
    if [[ "$vol" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then list+=("$vol"); fi
  done < <(grep -E '^docker/[^/]+\.tar\.gz$' "$TMP/list.txt" || true)
  ((${#list[@]} > 0)) || return 0
  if ! docker_ok; then
    echo "Docker is not available or not accessible: ${#list[@]} volume(s) in the archive were NOT restored (${list[*]}). Re-run import after fixing docker."
    return 0
  fi
  for vol in "${list[@]}"; do
    if docker volume inspect "$vol" >/dev/null 2>&1; then
      nonempty="$(docker run --rm -v "$vol:/v:ro" busybox sh -c 'ls -A /v | head -n 1' 2>/dev/null || echo unknown)"
      if [[ -n "$nonempty" ]]; then
        echo "Docker volume $vol exists and is not empty: NOT overwritten."
        continue
      fi
    else
      docker volume create "$vol" >/dev/null || { echo "Docker volume $vol could not be created."; continue; }
    fi
    : >"$TMP/gpg.err"
    if decrypt "$FILE" | gunz | tar -xOf - "docker/$vol.tar.gz" |
      docker run --rm -i -v "$vol:/v" busybox tar -C /v -xzf - 2>"$TMP/docker.err"; then
      echo "Docker volume $vol restored."
    else
      echo "Docker volume $vol: restore failed ($(tail -n 1 "$TMP/docker.err" 2>/dev/null))."
    fi
  done
}

clone_repos() { # clone_repos: sets CLONE_FAILED, CLONED, KEPT
  local path remote branch ok total seen=0 filter='.repos[] | select(.state == "clean" and (.rescued | not) and ((.remote // "") | length > 0))'
  CLONE_FAILED=() CLONED=0 KEPT=0
  need git
  total="$(jq -r "[$filter] | length" "$TMP/manifest.json")"
  progress clone 0
  while IFS=$'\x1f' read -r path remote branch; do
    progress clone $((seen * 100 / total))
    seen=$((seen + 1))
    [[ -n "$path" ]] || continue
    safe_rel "$path" || { CLONE_FAILED+=("$path (unsafe path)"); continue; }
    if [[ -e "$HOME/$path" ]]; then KEPT=$((KEPT + 1)); continue; fi
    mkdir -p "$(dirname -- "$HOME/$path")"
    ok=0
    export GIT_TERMINAL_PROMPT=0
    export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"
    if [[ -n "$branch" ]] && git -c protocol.ext.allow=never clone --quiet --branch "$branch" -- "$remote" "$HOME/$path" 2>/dev/null; then ok=1
    elif git -c protocol.ext.allow=never clone --quiet -- "$remote" "$HOME/$path" 2>"$TMP/clone.err"; then ok=1
    fi
    if ((ok)); then CLONED=$((CLONED + 1)); echo "  cloned $path"
    else CLONE_FAILED+=("$path <- $remote"); fi
  done < <(jq -r "$filter | [(.path // (\"projects/\" + .dir)), .remote, (.branch // \"\")] | join(\"\\u001f\")" "$TMP/manifest.json")
  progress clone 100
}

# The launcher config is not restored (it holds ALLOW_RUN, which the new server must set itself). Only a plain
# PROJECTS_DIR= line of the old file is taken, and only when this server's file has none.
merge_projects_dir() {
  local cfg="$HOME/.config/claude-launcher/config" line
  : >"$TMP/gpg.err"
  line="$({ decrypt "$FILE" | gunz | tar -xOf - .config/claude-launcher/config 2>/dev/null || true; } | grep -m1 '^PROJECTS_DIR=' || true)"
  [[ "$line" =~ ^PROJECTS_DIR=(\"[A-Za-z0-9._/\ \$\{\}~-]*\"|\'[A-Za-z0-9._/\ ~-]*\'|[A-Za-z0-9._/\$\{\}~-]*)$ ]] || return 0
  if [[ -f "$cfg" ]] && grep -q '^[[:space:]]*PROJECTS_DIR=' "$cfg"; then return 0; fi
  mkdir -p "$(dirname -- "$cfg")"
  printf '%s\n' "$line" >>"$cfg"
  chmod 600 "$cfg"
  echo "Took PROJECTS_DIR from the backup's launcher config (the rest of that file stays as it is here)."
}

# rewrite_home: the backup came from another home folder (another user name): point the restored files at this one.
# Text config only (json/env/mcp files), plus the chat-history folders, whose names are the project path with / and . as -.
rewrite_home() {
  local old new oe ne f oslug nslug d base dest
  old="$(jq -r '.home // empty' "$TMP/manifest.json")"
  new="$HOME"
  [[ "$old" == /* && "$old" != "$new" ]] || return 0
  oe="$(printf '%s' "$old" | sed 's/[][\.*^$|]/\\&/g')"
  ne="$(printf '%s' "$new" | sed 's/[\&|]/\\&/g')"
  while IFS= read -r f; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    if grep -qF -- "$old" "$f" 2>/dev/null; then sed -i "s|$oe|$ne|g" "$f"; fi
  done < <({
    for f in .claude.json .mcp.json .claude/settings.json .claude/settings.local.json .config/claude-launcher/env; do
      if [[ -f "$HOME/$f" ]]; then printf '%s\n' "$HOME/$f"; fi
    done
    find "$HOME/.claude/plugins" "$HOME/.config/claude-launcher" -maxdepth 1 -type f \( -name '*.json' -o -name env \) 2>/dev/null || true
    find "$HOME/.config/claude-launcher/workers" -maxdepth 4 -type f \( -name '.claude.json' -o -name 'settings*.json' \) -size -20M 2>/dev/null || true
  } | sort -u)
  oslug="$(printf '%s' "$old" | sed 's/[^A-Za-z0-9]/-/g')"
  nslug="$(printf '%s' "$new" | sed 's/[^A-Za-z0-9]/-/g')"
  for d in "$HOME/.claude/projects/$oslug"*; do
    [[ -d "$d" ]] || continue
    base="$(basename -- "$d")"
    [[ "$base" == "$oslug" || "$base" == "$oslug"-* ]] || continue
    dest="$HOME/.claude/projects/$nslug${base#"$oslug"}"
    if [[ -e "$dest" ]]; then cp -an -- "$d/." "$dest/" && rm -rf -- "$d"; else mv -- "$d" "$dest"; fi
  done
  echo "Rewrote $old to $new in the restored settings and chat history."
}

fix_permissions() {
  local f
  for f in .ssh .config/claude-launcher .claude backups; do
    if [[ -d "$HOME/$f" ]]; then chmod 700 "$HOME/$f"; fi
  done
  for f in .config/claude-launcher/env .git-credentials .npmrc .claude/.credentials.json .aws/credentials \
    .config/gh/hosts.yml .docker/config.json; do
    if [[ -f "$HOME/$f" ]]; then chmod 600 "$HOME/$f"; fi
  done
  if [[ -d "$HOME/.config/claude-launcher" ]]; then
    find "$HOME/.config/claude-launcher" -maxdepth 1 -type f -name '*.json' -exec chmod 600 {} + || true
  fi
  if [[ -d "$HOME/.ssh" ]]; then
    find "$HOME/.ssh" -maxdepth 1 -type f ! -name '*.pub' ! -name authorized_keys -exec chmod 600 {} + || true
  fi
  for f in claude-setup.sh .local/bin/claude-autostart .local/bin/clauderc-team .local/bin/claude-push \
    .local/bin/claude-plugin-updates .local/bin/youtube-upload; do
    if [[ -f "$HOME/$f" ]]; then chmod u+x "$HOME/$f"; fi
  done
  if [[ -d "$HOME/bin" ]]; then
    find "$HOME/bin" -maxdepth 1 -type f -exec chmod u+x {} + || true
  fi
}

todo_list() { # still-to-do list from the manifest
  local n
  echo
  echo "Still to do:"
  while IFS= read -r n; do echo "  - recreate docker container $n (compose files / run commands are in your projects)"; done \
    < <(jq -r '.docker_containers[]?' "$TMP/manifest.json")
  while IFS= read -r n; do echo "  - restore service $n (it was enabled on the old server; needs sudo, import does not touch systemd)"; done \
    < <(jq -r '.systemd_units[]?' "$TMP/manifest.json")
  n="$(jq -r '(.listening // []) | map(tostring) | join(", ")' "$TMP/manifest.json")"
  [[ -z "$n" ]] || echo "  - ports that listened on the old server: $n (VPN such as Tailscale, databases, nodes: sign in / restore them)"
  n="$(jq -r '(.other_dirs // []) - (.other_dirs_saved // []) | join(", ")' "$TMP/manifest.json")"
  [[ -z "$n" ]] || echo "  - project folders that are not git repos and were not copied: $n"
  if [[ "$(jq -r '.claude_logins_included' "$TMP/manifest.json")" == false ]]; then
    echo "  - Claude logins were NOT stored in this backup (export --no-claude-login): sign in to Claude here again"
  fi
  echo "  - re-check ALLOW_RUN/PROJECTS_DIR in ~/.config/claude-launcher/config (that file is not restored; this server keeps its own)"
  if ((WITHAK == 0)); then
    echo "  - ~/.ssh/authorized_keys was not restored (this server keeps its own keys); for a same-user move by hand use import --with-authorized-keys"
  else
    echo "  - ~/.ssh/authorized_keys was replaced by the old server's file: make sure the phone's key line is in it, or re-run the installer with the phone key"
  fi
  echo "  - worker logins (cLaudeCluster): re-sign in from the app (Claude tab > Accounts > Re-sign in); stop sessions on the old server first, two servers refreshing one login sign it out"
  echo "  - run 'claude-autostart install' (asks for sudo), then 'claude-autostart restore' or restart sessions from the app"
  echo "  - delete the backup file (it holds every secret) and the pre-restore folder when all is fine"
}

cmd_import() {
  local file="" dry=0 clone=0 from="" host rpath="" top pre ts n=0 p mout="" xex=()
  while (($#)); do
    case "$1" in
      --pass-file) (($# >= 2)) || bad_usage "--pass-file needs a file"; PASS_FILE="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --clone) clone=1; shift ;;
      --with-authorized-keys) WITHAK=1; shift ;;
      --manifest-out) (($# >= 2)) || bad_usage "--manifest-out needs a file"; mout="$2"; shift 2 ;;
      --from) (($# >= 2)) || bad_usage "--from needs USER@HOST"; from="$2"; shift 2 ;;
      -*) bad_usage "unknown option for import: $1" ;;
      *) [[ -z "$file" ]] || bad_usage "import takes one file"; file="$1"; shift ;;
    esac
  done
  need gpg tar jq gzip
  TMP="$(mktemp -d)"
  if [[ -n "$from" ]]; then
    [[ "$from" =~ ^([A-Za-z0-9_][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9.-]*)(:(.+))?$ ]] || bad_usage "--from needs USER@HOST (or USER@HOST:PATH)"
    host="${BASH_REMATCH[1]}"
    rpath="${BASH_REMATCH[3]}"
    [[ -n "$file" ]] || file="$rpath"
    [[ -n "$file" ]] || bad_usage "import needs the file's path on $host"
    [[ "$file" != -* ]] || bad_usage "file name must not start with -"
    if ((dry)); then die "--dry-run cannot be combined with --from (it would fetch the file): fetch it first, then dry-run"; fi
    fetch_from "$host" "$file"
  else
    [[ -n "$file" ]] || bad_usage "import needs a FILE"
    FILE="$(abs "$file")"
  fi
  [[ -f "$FILE" ]] || die "$FILE not found"
  [[ -z "${PASS_FILE:-}" ]] || PASS_FILE="$(abs "$PASS_FILE")"
  resolve_pass

  [[ -z "$mout" ]] || mout="$(abs "$mout")"

  echo "Checking the archive (a wrong passphrase or a damaged file stops here, nothing is written) ..."
  start_read verify "$FILE"
  check_archive "$FILE"
  stop_read
  progress verify 100
  read_manifest "$TMP/manifest.json" "$FILE"

  echo
  jq -r '"Backup of " + .user + "@" + .host + " made " + .created + (if .claude_version then " (claude " + .claude_version + ")" else "" end)' "$TMP/manifest.json"
  echo "Repos in the manifest:"
  jq -r '.repos[] | "  " + .path + "  [" + .state + "]  " + (if .rescued then "stored in the archive" elif .skipped_reason then "NOT stored: " + .skipped_reason else "not stored, clone with --clone" end)' "$TMP/manifest.json"
  echo "Paths restored into $HOME:"
  jq -r '.backed_up[] | "  " + .' "$TMP/manifest.json"
  top="$(grep -cE '^docker/[^/]+\.tar\.gz$' "$TMP/list.txt" || true)"
  [[ "$top" == 0 ]] || echo "Docker volumes in the archive: $top"

  if ((dry)); then
    echo
    echo "Dry run: $(wc -l <"$TMP/list.txt") archive entries, nothing was written."
    todo_list
    return 0
  fi

  mkdir -p "$HOME/backups"
  chmod 700 "$HOME/backups"
  ts="$(date +%Y%m%d-%H%M%S)"
  pre="$HOME/backups/pre-restore-$ts"
  cd "$HOME"
  while IFS= read -r p; do
    safe_rel "$p" || die "unsafe path in the manifest: $p"
    if [[ -e "$p" || -L "$p" ]]; then
      mkdir -p "$pre"
      cp -a --parents -- "$p" "$pre/" || die "could not copy $p to $pre; nothing was restored"
      n=$((n + 1))
    fi
  done < <(jq -r '.backed_up[]' "$TMP/manifest.json")
  ((n == 0)) || echo "Saved $n existing path(s) to $pre first."
  # Make sure the manifest can be written before anything is overwritten.
  if [[ -n "$mout" ]]; then mkdir -p "$(dirname -- "$mout")" || die "cannot create the folder of $mout"; fi

  echo "Restoring ..."
  : >"$TMP/gpg.err"
  start_read extract "$FILE"
  # Never restored: this server's own authorized_keys (unless asked), its launcher config (PROJECTS_DIR only, below), the migrate keys.
  xex=(--exclude=manifest.json --exclude=docker --exclude=.config/claude-launcher/config --exclude=.config/claude-launcher/migrate)
  # The server's own forced command stays the installed one; sshd also reads authorized_keys2 and runs ~/.ssh/rc / environment at login.
  xex+=(--exclude=bin/claude-launcher-api --exclude=.ssh/rc --exclude=.ssh/environment)
  ((WITHAK)) || xex+=("--exclude=.ssh/authorized_keys*")
  if ! (umask 022; decrypt "$FILE" | gunz | tar -xpf - -C "$HOME" --anchored "${xex[@]}"); then
    stop_read
    die "extracting failed half way (older files are in $pre)"
  fi
  stop_read
  progress extract 100
  merge_projects_dir
  rewrite_home
  fix_permissions

  if ((clone)); then
    echo "Cloning clean repos ..."
    clone_repos
    echo "Cloned $CLONED, kept $KEPT that already exist."
    if ((${#CLONE_FAILED[@]} > 0)); then
      echo "Could not clone (do it by hand):"
      printf '  %s\n' "${CLONE_FAILED[@]}"
    fi
  fi
  restore_docker
  if [[ -n "$mout" ]]; then
    cp -- "$TMP/manifest.json" "$mout" || die "restored, but could not write the manifest to $mout"
    chmod 600 "$mout"
  fi
  echo
  echo "Restore finished."
  todo_list
}

# clone MANIFEST: clone the manifest's clean, pushed repos that are missing here (after the GitHub sign-in was fixed).
cmd_clone() {
  [[ $# -eq 1 ]] || bad_usage "clone takes one manifest file"
  need jq git
  [[ -f "$1" ]] && jq -e 'type == "object"' "$1" >/dev/null 2>&1 || die "$1 isn't a manifest"
  TMP="$(mktemp -d)"
  cp -- "$1" "$TMP/manifest.json"
  clone_repos
  echo "Cloned $CLONED, kept $KEPT that already exist."
  if ((${#CLONE_FAILED[@]} > 0)); then
    echo "Could not clone:"
    printf '  %s\n' "${CLONE_FAILED[@]}"
    exit 1
  fi
}

# ---------------------------------------------------------------- main
(($# >= 1)) || { usage >&2; exit 2; }
sub="$1"
shift
case "$sub" in
  -h | --help | help) usage ;;
  export) cmd_export "$@" ;;
  plan) cmd_plan "$@" ;;
  receive) cmd_receive "$@" ;;
  import) cmd_import "$@" ;;
  clone) cmd_clone "$@" ;;
  list) cmd_list "$@" ;;
  *) bad_usage "unknown command: $sub" ;;
esac
