#!/usr/bin/env python3
"""claude-plugin-updates: say whether a newer version of each installed Claude Code plugin exists.

Prints ONE JSON object on stdout:
  {"<plugin>@<marketplace>": {"state": "current"|"available"|"unknown"|"error", "latest": "<12-char sha or version>"}}
for every plugin in $CLAUDE_PLUGIN_DIR/installed_plugins.json (default ~/.claude/plugins).

How it decides (marketplaces on disk are plain snapshots, not git repos):
  - catalog entry pins a "sha": compare with the installed commit, no network;
  - catalog entry is a git source without a sha: `git ls-remote` of its ref/HEAD;
  - catalog entry is a path inside the marketplace repo: `git ls-remote` HEAD of the
    marketplace repo, and if that moved, the GitHub compare API says whether files
    under the plugin's path changed;
  - otherwise the catalog's "version" is compared with the installed version.
Plugins whose marketplace repo is a `source` in the `skills` CLI's lock file
(npx skills add) are skills-managed: their answer also has "via":"skills" and
"source":"<owner/repo>", and they are judged by the repo's HEAD commit date against the
newest `updatedAt` the lock records for that source (the sha rules above don't apply).
Answers are cached in ~/.config/claude-launcher/plugin-updates.json (1 h; a failed
check keeps the last good answer for up to 24 h). Env: CLAUDE_PLUGIN_DIR,
XDG_CONFIG_HOME, CLAUDERC_GIT (git binary), CLAUDERC_GITHUB_API (API base),
CLAUDERC_SKILL_LOCK (default ~/.agents/.skill-lock.json),
CLAUDERC_PLUGIN_TTL (seconds; 0 = always recheck).
Never fails: any odd data ends in {} and exit 0.
"""
import datetime, json, os, re, subprocess, sys, tempfile, time, urllib.error, urllib.request

PLUGIN_DIR = os.environ.get("CLAUDE_PLUGIN_DIR") or os.path.expanduser("~/.claude/plugins")
CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "claude-launcher")
CACHE_FILE = os.path.join(CFG, "plugin-updates.json")
SKILL_LOCK = os.environ.get("CLAUDERC_SKILL_LOCK") or os.path.expanduser("~/.agents/.skill-lock.json")
GIT = os.environ.get("CLAUDERC_GIT") or "git"
API = (os.environ.get("CLAUDERC_GITHUB_API") or "https://api.github.com").rstrip("/")
DEFAULT_API = "https://api.github.com"
RAW = (os.environ.get("CLAUDERC_GITHUB_RAW") or "https://raw.githubusercontent.com").rstrip("/")
CALL_TIMEOUT = 20
RUN_CAP = 90
STALE_GOOD = 24 * 3600
COMPARE_LIMIT = 300
STATES = ("current", "available", "unknown", "error")
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
GH_URL_RE = re.compile(r"github\.com[:/]([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?$")
SHA_RE = re.compile(r"^[0-9a-f]{7,40}$")


class Fail(Exception):
    """A check that could not be completed (network, git, bad answer)."""


class OutOfTime(Exception):
    """The overall time cap was reached."""


def ttl():
    try:
        return max(0, float(os.environ.get("CLAUDERC_PLUGIN_TTL", "3600")))
    except ValueError:
        return 3600.0


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def as_dict(v):
    return v if isinstance(v, dict) else {}


def same_sha(a, b):
    a, b = a.lower(), b.lower()
    n = min(len(a), len(b))
    return n >= 7 and a[:n] == b[:n]


def parse_time(v):
    """Aware datetime for an ISO 8601 string (Z or offset; no zone = UTC), else None."""
    if not isinstance(v, str) or not v.strip():
        return None
    v = v.strip()
    if v[-1] in "zZ":
        v = v[:-1] + "+00:00"
    try:
        d = datetime.datetime.fromisoformat(v)
    except ValueError:
        return None
    return d if d.tzinfo else d.replace(tzinfo=datetime.timezone.utc)


def skill_sources():
    """lower-case owner/repo -> (owner/repo as written, newest updatedAt string, its datetime), from the skills lock."""
    out = {}
    skills = as_dict(as_dict(load_json(SKILL_LOCK)).get("skills"))
    for entry in skills.values():
        entry = as_dict(entry)
        src = entry.get("source")
        if not isinstance(src, str) or not REPO_RE.match(src):
            continue
        when = parse_time(entry.get("updatedAt"))
        have = out.get(src.lower())
        if have is None:
            out[src.lower()] = (src, entry["updatedAt"] if when else "", when)
        elif when and (have[2] is None or when > have[2]):
            out[src.lower()] = (have[0], entry["updatedAt"], when)
    return out


def repo_url(repo):
    return "https://github.com/%s.git" % repo


def github_repo(url):
    """owner/name for a GitHub clone URL, else None."""
    m = GH_URL_RE.search(url or "")
    return "%s/%s" % m.groups() if m else None


class Net:
    """Network calls with one overall deadline; repeated lookups are remembered."""

    def __init__(self):
        self.deadline = time.time() + RUN_CAP
        self.heads = {}
        self.compares = {}
        self.commits = {}
        self.manifests = {}

    def budget(self):
        left = self.deadline - time.time()
        if left <= 1:
            raise OutOfTime()
        return min(CALL_TIMEOUT, left)

    def ls_remote(self, url, ref=None):
        key = (url, ref or "HEAD")
        if key not in self.heads:
            try:
                self.heads[key] = self._ls_remote(url, ref or "HEAD")
            except Fail as e:
                self.heads[key] = e
        v = self.heads[key]
        if isinstance(v, Exception):
            raise v
        return v

    def _ls_remote(self, url, ref):
        env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
        env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")
        env.setdefault("GIT_ALLOW_PROTOCOL", "https:http:ssh:git:file")
        try:
            r = subprocess.run([GIT, "ls-remote", "--", url, ref], capture_output=True, text=True,
                               timeout=self.budget(), env=env, stdin=subprocess.DEVNULL,
                               start_new_session=True)
        except subprocess.TimeoutExpired:
            if time.time() >= self.deadline - 1:
                raise OutOfTime()
            raise Fail("git ls-remote timed out")
        except OSError as e:
            raise Fail("git: %s" % e)
        if r.returncode != 0:
            raise Fail("git ls-remote failed")
        rows = [ln.split("\t", 1) for ln in r.stdout.splitlines() if "\t" in ln]
        rows = [(s.strip().lower(), n.strip()) for s, n in rows if SHA_RE.match(s.strip().lower())]
        if not rows:
            raise Fail("ref not found")
        want = {ref, "refs/heads/" + ref, "refs/tags/" + ref + "^{}", "refs/tags/" + ref}
        for s, n in rows:
            if n in want:
                return s
        return rows[0][0]

    def changed_files(self, repo, old, new):
        """(paths, truncated) between two commits of a GitHub repo."""
        key = (repo, old, new)
        if key not in self.compares:
            try:
                self.compares[key] = self._compare(repo, old, new)
            except Fail as e:
                self.compares[key] = e
        v = self.compares[key]
        if isinstance(v, Exception):
            raise v
        return v

    def api_get(self, path):
        """Parsed JSON of a GitHub API GET."""
        headers = {"Accept": "application/vnd.github+json", "User-Agent": "claude-plugin-updates"}
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        if token and API == DEFAULT_API:
            headers["Authorization"] = "Bearer " + token
        req = urllib.request.Request("%s/%s" % (API, path), headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=self.budget()) as resp:
                return json.loads(resp.read().decode("utf-8", "replace"))
        except (urllib.error.URLError, OSError, ValueError) as e:
            if time.time() >= self.deadline - 1:
                raise OutOfTime()
            raise Fail("github api: %s" % e)

    def manifest_version(self, repo, ref, path):
        """The `version` a plugin's own .claude-plugin/plugin.json declares at <ref> (None: no manifest or no version)."""
        key = (repo, ref, path)
        if key not in self.manifests:
            try:
                self.manifests[key] = self._manifest_version(repo, ref, path)
            except Fail as e:
                self.manifests[key] = e
        v = self.manifests[key]
        if isinstance(v, Exception):
            raise v
        return v

    def _manifest_version(self, repo, ref, path):
        if not REPO_RE.match(repo) or not re.match(r"^[A-Za-z0-9._/-]*$", path + ref) or ".." in path:
            raise Fail("bad manifest location")
        url = "%s/%s/%s/%s.claude-plugin/plugin.json" % (RAW, repo, ref, path + "/" if path else "")
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "claude-plugin-updates"}), timeout=self.budget()) as resp:
                v = as_dict(json.loads(resp.read().decode("utf-8", "replace"))).get("version")
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            raise Fail("manifest: HTTP %s" % e.code)
        except (urllib.error.URLError, OSError, ValueError) as e:
            if time.time() >= self.deadline - 1:
                raise OutOfTime()
            raise Fail("manifest: %s" % e)
        return v.strip() if isinstance(v, str) and v.strip() else None

    def head_commit(self, repo):
        """(sha, commit date) of a GitHub repo's default branch."""
        if repo not in self.commits:
            try:
                self.commits[repo] = self._head_commit(repo)
            except Fail as e:
                self.commits[repo] = e
        v = self.commits[repo]
        if isinstance(v, Exception):
            raise v
        return v

    def _head_commit(self, repo):
        if not REPO_RE.match(repo):
            raise Fail("bad repo")
        data = as_dict(self.api_get("repos/%s/commits/HEAD" % repo))
        sha = data.get("sha")
        when = parse_time(as_dict(as_dict(data.get("commit")).get("committer")).get("date"))
        if not isinstance(sha, str) or not SHA_RE.match(sha.lower()) or when is None:
            raise Fail("bad commit answer")
        return sha.lower(), when

    def _compare(self, repo, old, new):
        if not REPO_RE.match(repo) or not SHA_RE.match(old) or not SHA_RE.match(new):
            raise Fail("bad compare arguments")
        data = as_dict(self.api_get("repos/%s/compare/%s...%s" % (repo, old, new)))
        if data.get("status") == "identical":
            return [], False
        files = data.get("files")
        if not isinstance(files, list):
            return [], True
        paths = [f.get("filename", "") for f in files if isinstance(f, dict)]
        # A rename also touches its old location.
        paths += [f["previous_filename"] for f in files if isinstance(f, dict) and f.get("previous_filename")]
        return paths, len(files) >= COMPARE_LIMIT


class Plugins:
    def __init__(self):
        self.net = Net()
        self.known = as_dict(load_json(os.path.join(PLUGIN_DIR, "known_marketplaces.json")))
        self.catalogs = {}

    def marketplace_dir(self, mk):
        if not mk or "/" in mk or mk in (".", ".."):
            return None
        d = os.path.join(PLUGIN_DIR, "marketplaces", mk)
        if os.path.isdir(d):
            return d
        loc = as_dict(self.known.get(mk)).get("installLocation")
        return loc if isinstance(loc, str) and os.path.isdir(loc) else None

    def catalog(self, mk):
        """name -> catalog entry, or None when the marketplace folder is missing."""
        if mk not in self.catalogs:
            d = self.marketplace_dir(mk)
            if d is None:
                self.catalogs[mk] = None
            else:
                by_name = {}
                data = as_dict(load_json(os.path.join(d, ".claude-plugin", "marketplace.json")))
                plugins = data.get("plugins")
                for p in plugins if isinstance(plugins, list) else []:
                    if isinstance(p, dict) and isinstance(p.get("name"), str):
                        by_name.setdefault(p["name"], p)
                self.catalogs[mk] = by_name
        return self.catalogs[mk]

    def marketplace_repo(self, mk):
        """(clone url, owner/name or None) of a marketplace's own repo, or (None, None)."""
        src = as_dict(as_dict(self.known.get(mk)).get("source"))
        repo, url = src.get("repo"), src.get("url")
        if isinstance(repo, str) and REPO_RE.match(repo):
            return repo_url(repo), repo
        if isinstance(url, str) and url:
            return url, github_repo(url)
        return None, None

    def git_source_url(self, src):
        repo, url = src.get("repo"), src.get("url")
        if isinstance(repo, str) and REPO_RE.match(repo):
            return repo_url(repo)
        if isinstance(url, str) and url:
            return repo_url(url) if REPO_RE.match(url) else url
        return None

    def check(self, name, mk, sha, version):
        """(state, latest) for one plugin; raises Fail / OutOfTime."""
        cat = self.catalog(mk)
        if cat is None:
            return "error", ""
        entry = cat.get(name)
        if entry is None:
            return "unknown", ""
        src = entry.get("source")
        verdict = None
        if isinstance(src, dict):
            if isinstance(src.get("sha"), str) and src["sha"].strip():
                verdict = self.compare_sha(sha, src["sha"].strip())
            else:
                url = self.git_source_url(src)
                ref = src.get("ref") if isinstance(src.get("ref"), str) and src.get("ref") else None
                if url:
                    verdict = self.compare_sha(sha, self.net.ls_remote(url, ref))
        elif isinstance(src, str):
            verdict = self.check_in_marketplace(mk, src, sha)
        if verdict and verdict[0] == "available" and version and not SHA_RE.match(version.lower()):
            # The plugin declares versions (not a sha): `claude plugin update` only moves when the declared version does,
            # so new commits alone are no update.
            verdict = self.declared_version(mk, entry, version, verdict)
        if verdict is None:
            cat_version = entry.get("version")
            if isinstance(cat_version, str) and cat_version and version:
                return ("current" if cat_version == version else "available"), cat_version
            return "unknown", ""
        return verdict

    def check_skills(self, source, updated):
        """(state, latest) for a plugin the skills CLI manages: is the repo's HEAD newer than the last `skills add`?"""
        sha, when = self.net.head_commit(source)
        return ("current" if updated is not None and updated >= when else "available"), sha[:12]

    def skills_managed(self, mk, sources):
        """(owner/repo as in the lock, newest updatedAt string, its datetime) when the marketplace repo is a skills source."""
        repo = self.marketplace_repo(mk)[1]
        return sources.get(repo.lower()) if repo else None

    def declared_version(self, mk, entry, version, verdict):
        """Replace a commit-based "available" by what the plugin's manifest version says."""
        src, ref, path, repo = entry.get("source"), "HEAD", "", None
        if isinstance(src, str):
            repo = self.marketplace_repo(mk)[1]
            path = src.strip()
            while path.startswith("./"):
                path = path[2:]
            path = path.strip("/")
        elif isinstance(src, dict):
            u = self.git_source_url(src)
            repo = github_repo(u) if u else None
            path = str(src.get("path") or "").strip("/")
            ref = str(src.get("sha") or src.get("ref") or "HEAD")
        if not repo:
            return "unknown", ""
        latest = self.net.manifest_version(repo, ref, path)
        if latest is None:
            return "unknown", ""
        return ("current" if latest == version else "available"), latest

    @staticmethod
    def compare_sha(have, latest):
        latest = latest.lower()
        if have and same_sha(have, latest):
            return "current", latest[:12]
        return "available", latest[:12]

    def check_in_marketplace(self, mk, rel, sha):
        url, repo = self.marketplace_repo(mk)
        if not url or not repo:
            return None
        latest = self.net.ls_remote(url)
        if not sha or not SHA_RE.match(sha.lower()):
            return None
        sha = sha.lower()
        if same_sha(sha, latest):
            return "current", latest[:12]
        path = rel.strip()
        while path.startswith("./"):
            path = path[2:]
        path = path.strip("/")
        paths, truncated = self.net.changed_files(repo, sha, latest)
        if truncated or not path or any(p == path or p.startswith(path + "/") for p in paths):
            return "available", latest[:12]
        return "current", latest[:12]


def newest(entries):
    items = [e for e in entries if isinstance(e, dict)] if isinstance(entries, list) else []
    if not items:
        return {}
    return max(enumerate(items), key=lambda p: (str(p[1].get("lastUpdated") or ""), p[0]))[1]


def read_cache():
    return as_dict(load_json(CACHE_FILE))


def write_cache(cache):
    try:
        os.makedirs(CFG, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=CFG, prefix="plugin-updates.json.")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(cache, f)
        os.replace(tmp, CACHE_FILE)
    except OSError:
        pass


def num(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else 0


def main():
    installed = as_dict(as_dict(load_json(os.path.join(PLUGIN_DIR, "installed_plugins.json"))).get("plugins"))
    old = read_cache()
    cache = {}
    out = {}
    now = time.time()
    limit = ttl()
    plugins = Plugins()
    sources = skill_sources()
    for pid, entries in installed.items():
        if not isinstance(pid, str):
            continue
        inst = newest(entries)
        sha = inst.get("gitCommitSha") if isinstance(inst.get("gitCommitSha"), str) else ""
        version = inst.get("version") if isinstance(inst.get("version"), str) else ""
        key = sha or version
        name, _, mk = pid.partition("@")
        managed = plugins.skills_managed(mk, sources) if mk else None
        extra = {}
        if managed:
            # Running `skills add` moves updatedAt, which must drop a cached "available" at once.
            key = "%s|skills|%s|%s" % (key, managed[0], managed[1])
            extra = {"via": "skills", "source": managed[0]}
        prev = as_dict(old.get(pid))
        same_install = prev.get("for") == key and prev.get("state") in STATES
        if same_install and now - max(num(prev.get("ts")), num(prev.get("tried"))) < limit:
            cache[pid] = prev
            out[pid] = dict(extra, state=prev["state"], latest=str(prev.get("latest") or ""))
            continue
        good = same_install and prev["state"] in ("current", "available") and now - num(prev.get("ts")) < STALE_GOOD
        try:
            if not mk:
                state, latest = "unknown", ""
            elif managed:
                state, latest = plugins.check_skills(managed[0], managed[2])
            else:
                state, latest = plugins.check(name, mk, sha, version)
        except (Fail, OutOfTime) as e:
            if good:
                cache[pid] = dict(prev, tried=now)
                out[pid] = dict(extra, state=prev["state"], latest=str(prev.get("latest") or ""))
            elif isinstance(e, OutOfTime):
                out[pid] = dict(extra, state="unknown", latest="")
            else:
                cache[pid] = dict(extra, **{"for": key, "ts": now, "state": "error", "latest": ""})
                out[pid] = dict(extra, state="error", latest="")
            continue
        except Exception:
            out[pid] = dict(extra, state="error", latest="")
            continue
        cache[pid] = dict(extra, **{"for": key, "ts": now, "state": state, "latest": latest})
        out[pid] = dict(extra, state=state, latest=latest)
    if cache != old:
        write_cache(cache)
    return out


if __name__ == "__main__":
    try:
        result = main()
    except Exception:
        result = {}
    try:
        sys.stdout.write(json.dumps(result) + "\n")
    except Exception:
        sys.stdout.write("{}\n")
    sys.exit(0)
