# cLaudeRC server config
# Copy to ~/.config/claude-launcher/config (claude-setup.sh creates it on first run).
# Everything personal lives here, never in the repo.

# Where project folders are created / cloned.
PROJECTS_DIR="$HOME/projects"

# Default GitHub owner for new repos (empty = your GitHub user).
DEFAULT_OWNER=""

# Default visibility for new repos: private or public.
DEFAULT_VISIBILITY="private"

# Prefix for tmux session names (session = prefix + project name).
# Leave empty to name sessions exactly after the project, as the menu always has.
SESSION_PREFIX=""

# AWS profile to check / log in (empty = default profile).
AWS_PROFILE_NAME=""

# Default region for access-key logins.
AWS_DEFAULT_REGION_NAME="us-east-1"

# Extra PATH entries for non-interactive SSH calls (colon separated),
# e.g. where `claude`, `gh` or `aws` are installed if not already on PATH.
EXTRA_PATH=""

# How long (seconds) the cached GitHub repo list stays fresh.
REPOS_CACHE_TTL=600
