SLOT_SH = ('b=$1; n=$2; m=$3; cred=$4; thr=$5; py=$6; gap=$7; shift 7; while :; do i=0; while [ $i -lt $n ]; do exec 9>"$b.$i"; '
           'flock -n 9 && { left=$(python3 -c "$py" "$cred"); k=s; [ "$left" -lt "$thr" ] && k=x; exec 8>"$b.mode"; flock -$k 8; '
