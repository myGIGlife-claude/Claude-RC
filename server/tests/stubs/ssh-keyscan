#!/usr/bin/env bash
# Test stub for ssh-keyscan: reports $STUB_STATE/host_key.pub as the host's key (see the ssh stub).
S="${STUB_STATE:-$HOME/.stub-state}"
port=22
while (($# > 1)); do
  case "$1" in
    -p) port="$2"; shift 2 ;;
    -t | -T) shift 2 ;;
    *) shift ;;
  esac
done
host="${1:-}"
printf '%s\n' "$host" "$port" >"$S/keyscan-argv"
[[ -e "$S/ssh-unreachable" || ! -f "$S/host_key.pub" ]] && exit 1
((port == 22)) && pat="$host" || pat="[$host]:$port"
echo "# $host:$port SSH-2.0-stub" >&2
awk -v h="$pat" '{print h, $1, $2}' "$S/host_key.pub"
