#!/usr/bin/env bash
S="$STUB_STATE"
case "$1 $2" in
  "sts get-caller-identity") [[ -f "$S/aws_ok" ]] || exit 255; echo '{"UserId":"AIDAEXAMPLE","Account":"123456789012","Arn":"arn:aws:iam::123456789012:user/demo"}' ;;
  "configure import") f="${4#file://}"; grep -q AKIA "$f" && touch "$S/aws_ok" ;;
  "configure set") ;;
  "configure get") [[ "$3" == sso_start_url && -f "$S/aws_sso" ]] && echo https://example.awsapps.com/start; true ;;
  "sso login")
    if [[ "$3" == help ]]; then echo "--use-device-code"; exit 0; fi
    echo "Browser will not be automatically opened."
    echo "Please visit the following URL:"
    echo ""
    echo "https://device.sso.us-east-1.amazonaws.com/"
    echo ""
    echo "Then enter the code:"
    echo ""
    echo "ABCD-EFGH"
    sleep 60 ;;
  *) echo "aws stub: $*" >&2; exit 1 ;;
esac
