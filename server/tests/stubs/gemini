#!/usr/bin/env bash
# Test stub for the Gemini CLI (`gemini -p "" -o json`): prompt on stdin, one JSON object on stdout.
echo "$*" >"${STUB_STATE:-/tmp}/gemini-args"
prompt="$(cat)"
if [[ "$prompt" == *FAIL* ]]; then echo '{"error":{"message":"stub gemini failure"}}'; exit 1; fi
jq -cn --arg r "gemini home=${GEMINI_CLI_HOME:-none} key=${GEMINI_API_KEY:-unset} cwd=$PWD args=$* prompt=$prompt" '{response:$r,stats:{}}'
