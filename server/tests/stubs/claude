#!/usr/bin/env bash
# Test stub for Claude Code.
S="${STUB_STATE:-$HOME/.stub-state}"; mkdir -p "$S"
case "$1 ${2:-}" in
  "auth login")
    echo "Select login method:"
    echo " ❯ 1. Claude account with subscription"
    echo "   2. Anthropic Console account"
    read -r _
    echo "Browser didn't open? Use the url below to sign in:"
    echo "https://claude.ai/oauth/authorize?code=true&client_id=demo&state=xyz"
    printf 'Paste code here if prompted > '
    read -r code
    if [[ "$code" == good* ]]; then
      d="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; mkdir -p "$d" && echo '{"claudeAiOauth":{}}' >"$d/.credentials.json"
      echo "Login successful."
    else
      echo "OAuth error: invalid code"; exit 1
    fi ;;
  "--remote-control "*)
    if [[ ! -f "$S/rc_enabled" ]]; then
      printf 'Enable Remote Control? (y/n) '
      read -r a
      [[ "$a" == y ]] && touch "$S/rc_enabled"
    fi
    exec sleep 1000 ;;
  "doctor ") printf '\033[1mNo installation issues found.\033[0m\n' ;;
  "plugin list")
    if [[ " $* " == *" --json "* ]]; then
      echo '{"installed":[{"id":"demo@market","version":"1.0","scope":"user","enabled":true}],"available":[{"pluginId":"demo@market","name":"demo","description":"A demo","marketplaceName":"market","installCount":3},{"pluginId":"other@market","name":"other","description":"Other","marketplaceName":"market","installCount":1}]}'
    else echo "Installed plugins: demo@market"; fi ;;
  "plugin marketplace") echo '[{"name":"market","source":"github","repo":"demo/market"}]' ;;
  "--version ") echo "2.1.999 (Claude Code)" ;;
  "plugin install") echo "Installed $3" ;;
  *) echo "claude stub: $*" >&2; exit 1 ;;
esac
